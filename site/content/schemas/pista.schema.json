{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pista",
  "description": "Una pista de música: site/content/musica/NN-titulo.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "status": {
      "description": "sample: muestra · draft: borrador · review: en revisión · published: revisada y en la web pública",
      "enum": [
        "sample",
        "draft",
        "review",
        "published"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Título de la pista"
    },
    "release": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Nombre del disco; también da su portada"
    },
    "album": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Línea bajo el título, por ejemplo «EP Ceniza · 2025»"
    },
    "dur": {
      "type": "string",
      "pattern": "^\\d+:[0-5]\\d$",
      "description": "Duración, como 3:42"
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "description": "Las notas (en hercios) de la muestra que suena en el navegador"
    },
    "aka": {
      "description": "Títulos anteriores: los enlaces compartidos antes de un cambio de título siguen llegando a la obra",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "required": [
    "status",
    "title",
    "release",
    "album",
    "dur",
    "notes"
  ],
  "additionalProperties": false
}
