{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sobre",
  "description": "La sección «Sobre»: site/content/sobre.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "status": {
      "description": "sample: muestra · draft: borrador · review: en revisión · published: revisada y en la web pública",
      "enum": [
        "sample",
        "draft",
        "review",
        "published"
      ]
    },
    "lead": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "La frase grande con que empieza"
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "description": "Los párrafos que siguen"
    },
    "trayectoria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "year",
          "text"
        ],
        "properties": {
          "status": {
            "description": "sample: muestra · draft: borrador · review: en revisión · published: revisada y en la web pública",
            "enum": [
              "sample",
              "draft",
              "review",
              "published"
            ]
          },
          "year": {
            "description": "Año de cuatro cifras",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1000,
                "maximum": 9999
              },
              {
                "type": "string",
                "pattern": "^\\d{4}$"
              }
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "required": [
    "status",
    "lead",
    "paragraphs"
  ],
  "additionalProperties": false
}
