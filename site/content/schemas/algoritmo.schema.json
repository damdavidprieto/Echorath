{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Algoritmo",
  "description": "El estado de un algoritmo: site/content/algoritmos/NN-nombre/meta.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "status": {
      "description": "sample: muestra · draft: borrador · review: en revisión · published: revisada y en la web pública",
      "enum": [
        "sample",
        "draft",
        "review",
        "published"
      ]
    }
  },
  "required": [
    "status"
  ],
  "additionalProperties": false
}
